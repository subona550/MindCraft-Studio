<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>MindCraft Studio — Cognitive & Reflex Games</title>
  <!-- Telegram Mini App SDK -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <!-- AdsGram SDK -->
  <script src="https://sad.adsgram.ai/js/sad.min.js"></script>
  <style>
    :root {
      --bg: #0b1120;
      --surface: #131c31;
      --surface-2: #1e293b;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --accent-soft: rgba(56, 189, 248, 0.16);
      --ok: #22c55e;
      --err: #ef4444;
      --warn: #f59e0b;
      --radius: 16px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding-bottom: 84px;
      overflow-x: hidden;
    }

    /* Header */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      background: rgba(11, 17, 32, 0.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo {
      width: 36px;
      height: 36px;
      border-radius: 11px;
      background: linear-gradient(135deg, var(--accent), #6366f1);
      color: #0b1120;
      font-weight: 900;
      font-size: 17px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .brand h1 {
      font-size: 15px;
      font-weight: 700;
    }

    .brand small {
      display: block;
      font-size: 11px;
      color: var(--muted);
    }

    .gem-pill {
      background: var(--surface);
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      color: var(--accent);
    }

    .wrap {
      max-width: 500px;
      margin: 0 auto;
      padding: 14px 16px;
    }

    .page {
      display: none;
      animation: fadeSlide 0.2s ease;
    }
    .page.active {
      display: block;
    }
    @keyframes fadeSlide {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .card {
      background: var(--surface);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: var(--radius);
      padding: 15px;
      margin-bottom: 14px;
    }

    .card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
      font-size: 15px;
      font-weight: 700;
    }

    .desc {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.45;
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 14px;
    }

    .stat-box {
      background: var(--surface);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      padding: 10px 6px;
      text-align: center;
    }

    .stat-box .num {
      font-size: 18px;
      font-weight: 800;
      color: var(--accent);
    }

    .stat-box .lbl {
      font-size: 11px;
      color: var(--muted);
    }

    .btn {
      width: 100%;
      border: none;
      border-radius: 12px;
      padding: 13px 15px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: transform 0.12s, opacity 0.15s;
    }

    .btn:active { transform: scale(0.97); }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .btn-primary { background: var(--accent); color: #0b1120; }
    .btn-secondary { background: var(--surface-2); color: var(--text); }
    .btn-ad {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #fff;
      flex-direction: column;
      gap: 2px;
      padding: 11px 14px;
    }
    .btn-ad small {
      font-size: 11px;
      font-weight: 500;
      opacity: 0.92;
    }
    .btn-sm {
      width: auto;
      padding: 8px 12px;
      font-size: 12px;
    }

    /* PAGE 1: Pattern Grid */
    .status-line {
      text-align: center;
      font-size: 14px;
      font-weight: 600;
      color: var(--accent);
      min-height: 22px;
    }

    .grid-3x3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin: 14px 0;
    }

    .cell {
      aspect-ratio: 1;
      background: var(--surface-2);
      border-radius: 14px;
      border: 2px solid rgba(255, 255, 255, 0.05);
      cursor: pointer;
      transition: 0.14s;
    }

    .cell.lit {
      background: var(--accent);
      box-shadow: 0 0 22px var(--accent-soft);
      transform: scale(0.95);
    }
    .cell.ok {
      background: var(--ok);
      box-shadow: 0 0 18px rgba(34, 197, 94, 0.35);
    }
    .cell.err {
      background: var(--err);
      box-shadow: 0 0 18px rgba(239, 68, 68, 0.35);
    }

    /* PAGE 2: Cognitive Sprint */
    .mode-switch {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 12px;
    }

    .mode-btn {
      padding: 9px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.08);
      background: var(--surface-2);
      color: var(--muted);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    .mode-btn.active {
      background: var(--accent-soft);
      color: var(--accent);
      border-color: var(--accent);
    }

    .sprint-prompt {
      text-align: center;
      padding: 24px 12px;
      background: rgba(11, 17, 32, 0.6);
      border-radius: 14px;
      margin: 12px 0;
    }

    .prompt-big {
      font-size: 32px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .sprint-options {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 12px;
    }

    .sprint-opt {
      padding: 14px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.1);
      background: var(--surface-2);
      color: var(--text);
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
    }

    /* PAGE 3: Analytics & History */
    .list-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      font-size: 13px;
    }
    .list-row:last-child { border-bottom: none; }

    .pill {
      padding: 4px 9px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }
    .pill-ok { background: rgba(34, 197, 94, 0.18); color: #4ade80; }
    .pill-lock { background: rgba(148, 163, 184, 0.15); color: var(--muted); }

    /* PAGE 4: Workshop & Settings */
    .toggle-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      font-size: 14px;
    }
    .toggle-row:last-child { border-bottom: none; }

    .policy-box {
      background: rgba(11, 17, 32, 0.55);
      border-radius: 12px;
      padding: 12px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.55;
      margin-top: 8px;
    }

    /* Bottom Navigation */
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(11, 17, 32, 0.96);
      backdrop-filter: blur(12px);
      border-top: 1px solid rgba(255,255,255,0.08);
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      padding: 8px 4px 12px;
      z-index: 30;
    }

    .nav-item {
      background: none;
      border: none;
      color: var(--muted);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
    }
    .nav-item.active { color: var(--accent); }
    .nav-item span:first-child { font-size: 18px; }

    /* Ad Consent Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.72);
      display: none;
      align-items: flex-end;
      justify-content: center;
      z-index: 60;
      padding: 14px;
    }
    .modal-backdrop.open { display: flex; }

    .modal-sheet {
      width: 100%;
      max-width: 480px;
      background: var(--surface);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px;
      padding: 18px;
    }

    .toast {
      position: fixed;
      top: 68px;
      left: 50%;
      transform: translateX(-50%);
      background: #020617;
      border: 1px solid var(--accent);
      color: var(--text);
      padding: 9px 16px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      z-index: 70;
      display: none;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header class="topbar">
    <div class="brand">
      <div class="logo">MC</div>
      <div>
        <h1>MindCraft Studio</h1>
        <small id="tg-user-label">Cognitive Training App</small>
      </div>
    </div>
    <div class="gem-pill">💎 <span id="gems-val">0</span></div>
  </header>

  <div id="toast" class="toast"></div>

  <main class="wrap">

    <!-- ================= PAGE 1: MEMORY PATTERN LAB ================= -->
    <section id="page-memory" class="page active">
      <div class="card">
        <div class="card-head">
          <span>🧩 Memory Pattern Lab</span>
          <span style="font-size:12px; color:var(--muted);">Best Lv: <b id="mem-best">1</b></span>
        </div>
        <p class="desc">টাইলসগুলোর আলোর ক্রম মনে রাখুন এবং ঠিক একইভাবে ট্যাপ করুন। এটি ১০০% ফ্রি ও অ্যাড ছাড়াই খেলা যায়।</p>
      </div>

      <div class="stats-row">
        <div class="stat-box"><div class="num" id="mem-level">1</div><div class="lbl">Level</div></div>
        <div class="stat-box"><div class="num" id="mem-lives">2</div><div class="lbl">Lives</div></div>
        <div class="stat-box"><div class="num" id="mem-shields">0</div><div class="lbl">Shields</div></div>
      </div>

      <div class="card">
        <div id="mem-status" class="status-line">খেলতে Start বাটনে চাপুন</div>
        <div class="grid-3x3" id="mem-grid">
          <div class="cell" data-i="0"></div><div class="cell" data-i="1"></div><div class="cell" data-i="2"></div>
          <div class="cell" data-i="3"></div><div class="cell" data-i="4"></div><div class="cell" data-i="5"></div>
          <div class="cell" data-i="6"></div><div class="cell" data-i="7"></div><div class="cell" data-i="8"></div>
        </div>

        <button id="mem-start-btn" class="btn btn-primary" onclick="startMemoryRound()">▶ Start Round</button>

        <!-- Explicit Ad Placement #1 -->
        <button id="mem-ad-btn" class="btn btn-ad" style="margin-top:10px; display:none;" onclick="triggerAdForLife()">
          <span>📺 Watch Ad to Revive (+1 Life)</span>
          <small>Optional Rewarded Ad • Watch a short video ad to continue</small>
        </button>
      </div>
    </section>

    <!-- ================= PAGE 2: COGNITIVE SPRINT (MATH & STROOP) ================= -->
    <section id="page-sprint" class="page">
      <div class="card">
        <div class="card-head">
          <span>⚡ Cognitive Sprint</span>
          <span style="font-size:12px; color:var(--ok);">30s Challenge</span>
        </div>
        <p class="desc">৩০ সেকেন্ডে যত বেশি সম্ভব সঠিক উত্তর দিন। প্রতিটি রাউন্ডে নতুন ও ডায়নামিক প্রশ্ন তৈরি হয়।</p>
      </div>

      <div class="mode-switch">
        <button id="mode-math" class="mode-btn active" onclick="setSprintMode('math')">➕ Quick Math</button>
        <button id="mode-stroop" class="mode-btn" onclick="setSprintMode('stroop')">🎨 Color Reflex</button>
      </div>

      <div class="stats-row">
        <div class="stat-box"><div class="num" id="sp-timer">30s</div><div class="lbl">Time Left</div></div>
        <div class="stat-box"><div class="num" id="sp-score">0</div><div class="lbl">Score</div></div>
        <div class="stat-box"><div class="num" id="sp-best">0</div><div class="lbl">Best</div></div>
      </div>

      <div class="card">
        <div class="sprint-prompt">
          <div id="sp-instruction" style="font-size:12px; color:var(--muted); margin-bottom:6px;">
            সঠিক উত্তর নির্বাচন করুন
          </div>
          <div id="sp-question" class="prompt-big">Ready?</div>
        </div>

        <div id="sp-options" class="sprint-options"></div>

        <button id="sp-start-btn" class="btn btn-primary" onclick="startSprint()">▶ Start 30s Sprint</button>

        <!-- Explicit Ad Placement #2 -->
        <button id="sp-ad-btn" class="btn btn-ad" style="margin-top:10px; display:none;" onclick="triggerAdForTime()">
          <span>📺 Watch Ad for +15s Time Boost</span>
          <small>Optional Rewarded Ad • Adds 15s once per round</small>
        </button>
      </div>
    </section>

    <!-- ================= PAGE 3: PROGRESS & HISTORY ================= -->
    <section id="page-stats" class="page">
      <div class="card">
        <div class="card-head">
          <span>📊 Performance & Badges</span>
          <span id="rank-tag" class="pill pill-ok">Trainee</span>
        </div>
        <p class="desc" id="profile-summary">আপনার গেম খেলার আসল রেকর্ড ও অ্যাচিভমেন্ট এখানে সেভ থাকে।</p>
      </div>

      <div class="stats-row">
        <div class="stat-box"><div class="num" id="st-sessions">0</div><div class="lbl">Sessions</div></div>
        <div class="stat-box"><div class="num" id="st-accuracy">0%</div><div class="lbl">Accuracy</div></div>
        <div class="stat-box"><div class="num" id="st-gems">0</div><div class="lbl">Virtual Gems</div></div>
      </div>

      <div class="card">
        <div class="card-head"><span>🏆 Badges</span></div>
        <div id="badges-box"></div>
      </div>

      <div class="card">
        <div class="card-head"><span>🕒 Recent Activity</span></div>
        <div id="history-box"></div>
      </div>
    </section>

    <!-- ================= PAGE 4: WORKSHOP, CONSENT & AD POLICY ================= -->
    <section id="page-settings" class="page">
      <div class="card">
        <div class="card-head"><span>🎨 Virtual Workshop</span></div>
        <p class="desc">গেম খেলে পাওয়া ভার্চুয়াল Gems দিয়ে ইন-গেম বুস্টার ও থিম আনলক করুন।</p>

        <div class="list-row">
          <div>
            <b>🛡 Memory Shield (+1)</b>
            <div class="desc">ভুল ট্যাপ করলে ১ বার লাইফ রক্ষা করবে</div>
          </div>
          <button class="btn btn-primary btn-sm" onclick="buyShield()">40 💎</button>
        </div>

        <div class="list-row">
          <div>
            <b>🌿 Mint Accent Theme</b>
            <div class="desc">অ্যাপের কালার থিম পরিবর্তন</div>
          </div>
          <button id="btn-theme-mint" class="btn btn-secondary btn-sm" onclick="handleTheme('mint', '#10b981', 60)">60 💎</button>
        </div>

        <div class="list-row">
          <div>
            <b>🔮 Violet Accent Theme</b>
            <div class="desc">পার্পল ফোকাস থিম</div>
          </div>
          <button id="btn-theme-violet" class="btn btn-secondary btn-sm" onclick="handleTheme('violet', '#a855f7', 90)">90 💎</button>
        </div>
      </div>

      <div class="card">
        <div class="card-head"><span>⚙ Preferences & Ad Consent</span></div>
        <div class="toggle-row">
          <span>Sound Effects (Synth Audio)</span>
          <input type="checkbox" id="opt-sound" onchange="updatePreferences()" style="width:18px;height:18px;">
        </div>
        <div class="toggle-row">
          <span>Haptic Vibration</span>
          <input type="checkbox" id="opt-haptic" onchange="updatePreferences()" style="width:18px;height:18px;">
        </div>
        <div class="toggle-row">
          <span>Allow Optional Rewarded Ads</span>
          <input type="checkbox" id="opt-ads" onchange="updateAdConsentFromToggle()" style="width:18px;height:18px;">
        </div>
        <div class="toggle-row">
          <span>Reset All Local Data</span>
          <button class="btn btn-secondary btn-sm" onclick="resetAll()">Reset</button>
        </div>
      </div>

      <div class="card">
        <div class="card-head"><span>ℹ Ad Placement & Virtual Reward Notice</span></div>
        <div class="policy-box">
          <b>1. Core Features Are Ad-Free:</b> Memory Pattern Lab এবং Cognitive Sprint গেমগুলো কোনো অ্যাড দেখা ছাড়াই সম্পূর্ণভাবে খেলা যায়।<br><br>
          <b>2. Exact Ad Placement Locations:</b><br>
          • <i>Placement #1 (Page 1 - Memory Lab):</i> গেম ওভার হলে "+1 Extra Life" নেওয়ার ঐচ্ছিক বাটন।<br>
          • <i>Placement #2 (Page 2 - Cognitive Sprint):</i> সময় শেষ হলে "+15s Time Boost" নেওয়ার ঐচ্ছিক বাটন।<br><br>
          <b>3. Virtual In-Game Items Only:</b> Gems, Shields এবং Lives শুধুমাত্র অ্যাপের ভেতরের ভার্চুয়াল গেমপ্লে ও থিম আনলকের জন্য। এর কোনো আর্থিক/নগদ মূল্য নেই এবং কোনো ক্যাশ-আউট দাবি করা হয় না।
        </div>
      </div>
    </section>

  </main>

  <!-- 4-Page Bottom Navigation -->
  <nav class="bottom-nav">
    <button class="nav-item active" onclick="goPage('memory', this)">
      <span>🧩</span><span>Memory</span>
    </button>
    <button class="nav-item" onclick="goPage('sprint', this)">
      <span>⚡</span><span>Sprint</span>
    </button>
    <button class="nav-item" onclick="goPage('stats', this)">
      <span>📊</span><span>Progress</span>
    </button>
    <button class="nav-item" onclick="goPage('settings', this)">
      <span>⚙</span><span>Workshop</span>
    </button>
  </nav>

  <!-- Explicit User Ad Consent Modal -->
  <div id="consent-modal" class="modal-backdrop">
    <div class="modal-sheet">
      <h3 style="font-size:17px; margin-bottom:8px;">👋 Welcome to MindCraft Studio</h3>
      <p class="desc" style="margin-bottom:14px;">
        এই অ্যাপের সব গেম ও ফিচার সম্পূর্ণ ফ্রি এবং অ্যাড ছাড়াই খেলা যায়।<br><br>
        তবে আপনি চাইলে গেমের ভেতরে <b>ঐচ্ছিক Rewarded Ads</b> দেখে বোনাস (যেমন: +1 Extra Life বা +15s Time Boost) নিতে পারবেন। অ্যাড দেখানোতে আপনার সম্মতি আছে কি?
      </p>
      <div style="display:flex; gap:10px;">
        <button class="btn btn-secondary" onclick="setConsent(false)">No Ads (Play Free)</button>
        <button class="btn btn-primary" onclick="setConsent(true)">I Agree (Optional Ads)</button>
      </div>
    </div>
  </div>

  <script>
    // ================= TELEGRAM & ADSGRAM SETUP =================
    const tg = window.Telegram?.WebApp;
    if (tg) {
      tg.ready();
      tg.expand();
    }

    // AdsGram থেকে পাওয়া আপনার আসল Block ID এখানে বসাবেন (যেমন: "12345")
    const ADSGRAM_BLOCK_ID = "";
    let AdController = null;
    if (ADSGRAM_BLOCK_ID && window.Adsgram) {
      AdController = window.Adsgram.init({ blockId: ADSGRAM_BLOCK_ID });
    }

    // ================= STATE =================
    const DEFAULT_STATE = {
      gems: 20,
      memBest: 1,
      sprintBest: 0,
      shields: 0,
      sessions: 0,
      totalCorrect: 0,
      totalAttempts: 0,
      sound: true,
      haptic: true,
      adConsent: null, // null = not asked yet, true = agreed, false = declined
      themes: ['default'],
      activeTheme: 'default',
      history: []
    };

    let state = JSON.parse(localStorage.getItem('mindcraft_v2')) || { ...DEFAULT_STATE };

    function save() {
      localStorage.setItem('mindcraft_v2', JSON.stringify(state));
      refreshUI();
    }

    // ================= AUDIO & HAPTIC =================
    let audioCtx = null;
    function beep(type = 'tap') {
      if (!state.sound) return;
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        const now = audioCtx.currentTime;
        if (type === 'ok') {
          osc.frequency.setValueAtTime(620, now);
          osc.frequency.exponentialRampToValueAtTime(880, now + 0.1);
          gain.gain.setValueAtTime(0.08, now);
          osc.start(now); osc.stop(now + 0.12);
        } else if (type === 'err') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(190, now);
          gain.gain.setValueAtTime(0.07, now);
          osc.start(now); osc.stop(now + 0.18);
        } else {
          osc.frequency.setValueAtTime(440, now);
          gain.gain.setValueAtTime(0.05, now);
          osc.start(now); osc.stop(now + 0.06);
        }
      } catch (e) {}
    }

    function buzz(kind = 'light') {
      if (!state.haptic || !tg?.HapticFeedback) return;
      if (kind === 'success' || kind === 'error') {
        tg.HapticFeedback.notificationOccurred(kind);
      } else {
        tg.HapticFeedback.impactOccurred(kind);
      }
    }

    function toast(msg) {
      const el = document.getElementById('toast');
      el.innerText = msg;
      el.style.display = 'block';
      setTimeout(() => el.style.display = 'none', 2300);
    }

    // ================= CONSENT & ADSGRAM =================
    function checkConsent() {
      if (state.adConsent === null) {
        document.getElementById('consent-modal').classList.add('open');
      }
    }

    function setConsent(agreed) {
      state.adConsent = agreed;
      document.getElementById('consent-modal').classList.remove('open');
      save();
      toast(agreed ? 'Optional Rewarded Ads enabled.' : 'Ads disabled. Enjoy ad-free play!');
    }

    function updateAdConsentFromToggle() {
      state.adConsent = document.getElementById('opt-ads').checked;
      save();
      // Hide visible ad buttons immediately if declined
      if (!state.adConsent) {
        document.getElementById('mem-ad-btn').style.display = 'none';
        document.getElementById('sp-ad-btn').style.display = 'none';
      }
    }

    function runRewardedAd(onSuccess) {
      if (!state.adConsent) {
        toast('আপনি Ads বন্ধ রেখেছেন। Workshop থেকে চালু করতে পারেন।');
        return;
      }
      if (AdController) {
        AdController.show()
          .then(() => onSuccess())
          .catch(() => toast('Ad সম্পূর্ণ হয়নি বা এখন অ্যাড নেই।'));
      } else {
        // Safe preview before live Block ID is configured
        toast('Ad Preview Mode (Block ID যুক্ত করলে আসল অ্যাড চলবে)');
        setTimeout(onSuccess, 700);
      }
    }

    // ================= NAVIGATION =================
    function goPage(name, navEl) {
      buzz('light');
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById(`page-${name}`).classList.add('active');
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      if (navEl) navEl.classList.add('active');

      if (name === 'stats') renderStats();
      if (name === 'settings') renderWorkshop();
    }

    // ================= PAGE 1: MEMORY PATTERN LAB =================
    let memLevel = 1;
    let memLives = 2;
    let memSeq = [];
    let memStep = 0;
    let memPlayingSeq = false;
    let memUserTurn = false;
    let memAdUsed = false;

    const cells = document.querySelectorAll('#mem-grid .cell');
    cells.forEach(c => c.addEventListener('click', () => onCellTap(Number(c.dataset.i))));

    function startMemoryRound() {
      if (memPlayingSeq) return;
      if (memLives <= 0) {
        memLevel = 1;
        memLives = 2;
        memAdUsed = false;
      }
      document.getElementById('mem-ad-btn').style.display = 'none';
      document.getElementById('mem-level').innerText = memLevel;
      document.getElementById('mem-lives').innerText = memLives;

      const seqLen = Math.min(2 + memLevel, 9);
      memSeq = Array.from({ length: seqLen }, () => Math.floor(Math.random() * 9));
      memStep = 0;
      memUserTurn = false;
      memPlayingSeq = true;
      document.getElementById('mem-start-btn').disabled = true;
      document.getElementById('mem-status').innerText = 'প্যাটার্নটি মনোযোগ দিয়ে দেখুন...';

      let idx = 0;
      const timer = setInterval(() => {
        if (idx >= memSeq.length) {
          clearInterval(timer);
          memPlayingSeq = false;
          memUserTurn = true;
          document.getElementById('mem-status').innerText = 'এবার ঠিক একইভাবে ট্যাপ করুন!';
          return;
        }
        flashCell(memSeq[idx], 'lit', 340);
        beep('tap');
        idx++;
      }, 520);
    }

    function flashCell(i, cls, ms) {
      cells[i].classList.add(cls);
      setTimeout(() => cells[i].classList.remove(cls), ms);
    }

    function onCellTap(i) {
      if (!memUserTurn || memPlayingSeq) return;
      buzz('light');
      state.totalAttempts += 1;

      if (i === memSeq[memStep]) {
        flashCell(i, 'ok', 220);
        beep('ok');
        state.totalCorrect += 1;
        memStep++;

        if (memStep === memSeq.length) {
          memUserTurn = false;
          buzz('success');
          const gain = 6 + memLevel;
          state.gems += gain;
          state.sessions += 1;
          if (memLevel > state.memBest) state.memBest = memLevel;
          addHistory(`Memory Lv.${memLevel}`, `+${gain} 💎`);
          memLevel++;
          save();

          document.getElementById('mem-level').innerText = memLevel;
          document.getElementById('mem-status').innerText = `চমৎকার! +${gain} 💎 পেয়েছেন`;
          document.getElementById('mem-start-btn').disabled = false;
          document.getElementById('mem-start-btn').innerText = `▶ Play Level ${memLevel}`;
        }
      } else {
        flashCell(i, 'err', 320);
        beep('err');
        buzz('error');
        memUserTurn = false;
        document.getElementById('mem-start-btn').disabled = false;

        if (state.shields > 0) {
          state.shields -= 1;
          save();
          document.getElementById('mem-status').innerText = '🛡 Shield লাইফ বাঁচিয়েছে! আবার খেলুন।';
          document.getElementById('mem-start-btn').innerText = `▶ Retry Level ${memLevel}`;
          return;
        }

        memLives -= 1;
        document.getElementById('mem-lives').innerText = memLives;
        save();

        if (memLives <= 0) {
          document.getElementById('mem-status').innerText = 'গেম ওভার! নতুন করে শুরু করুন।';
          document.getElementById('mem-start-btn').innerText = '🔄 Restart Level 1';
          if (state.adConsent && !memAdUsed) {
            document.getElementById('mem-ad-btn').style.display = 'flex';
          }
        } else {
          document.getElementById('mem-status').innerText = 'ভুল ট্যাপ! ১টি লাইফ বাকি আছে।';
          document.getElementById('mem-start-btn').innerText = `▶ Retry Level ${memLevel}`;
        }
      }
    }

    function triggerAdForLife() {
      runRewardedAd(() => {
        memLives = 1;
        memAdUsed = true;
        document.getElementById('mem-lives').innerText = memLives;
        document.getElementById('mem-ad-btn').style.display = 'none';
        document.getElementById('mem-status').innerText = '❤️ +1 Extra Life যোগ হয়েছে!';
        document.getElementById('mem-start-btn').innerText = `▶ Continue Level ${memLevel}`;
      });
    }

    // ================= PAGE 2: COGNITIVE SPRINT =================
    let sprintMode = 'math'; // 'math' | 'stroop'
    let sprintRunning = false;
    let sprintTime = 30;
    let sprintScore = 0;
    let sprintTimerId = null;
    let sprintAdUsed = false;
    let currentCorrectAns = null;

    const STROOP_COLORS = [
      { name: 'RED', hex: '#ef4444' },
      { name: 'BLUE', hex: '#38bdf8' },
      { name: 'GREEN', hex: '#22c55e' },
      { name: 'YELLOW', hex: '#facc15' }
    ];

    function setSprintMode(mode) {
      if (sprintRunning) return;
      sprintMode = mode;
      document.getElementById('mode-math').classList.toggle('active', mode === 'math');
      document.getElementById('mode-stroop').classList.toggle('active', mode === 'stroop');
      document.getElementById('sp-instruction').innerText =
        mode === 'math' ? 'দ্রুত সঠিক যোগফল/বিয়োগফল বের করুন' : 'লেখাটি যে রঙের (Ink Color), সেই রঙটি চাপুন!';
      document.getElementById('sp-question').innerText = 'Ready?';
      document.getElementById('sp-question').style.color = 'var(--text)';
      document.getElementById('sp-options').innerHTML = '';
    }

    function startSprint() {
      if (sprintRunning) return;
      sprintRunning = true;
      sprintTime = 30;
      sprintScore = 0;
      sprintAdUsed = false;

      document.getElementById('sp-score').innerText = '0';
      document.getElementById('sp-timer').innerText = '30s';
      document.getElementById('sp-start-btn').disabled = true;
      document.getElementById('sp-ad-btn').style.display = 'none';

      nextSprintPuzzle();

      clearInterval(sprintTimerId);
      sprintTimerId = setInterval(() => {
        sprintTime--;
        document.getElementById('sp-timer').innerText = `${sprintTime}s`;
        if (sprintTime <= 0) {
          endSprint();
        }
      }, 1000);
    }

    function nextSprintPuzzle() {
      const qEl = document.getElementById('sp-question');
      const optBox = document.getElementById('sp-options');
      optBox.innerHTML = '';

      if (sprintMode === 'math') {
        qEl.style.color = 'var(--text)';
        const a = Math.floor(Math.random() * 18) + 3;
        const b = Math.floor(Math.random() * 15) + 2;
        const isPlus = Math.random() > 0.4;
        const ans = isPlus ? a + b : a - b;
        currentCorrectAns = String(ans);
        qEl.innerText = isPlus ? `${a} + ${b} = ?` : `${a} - ${b} = ?`;

        const choices = new Set([ans]);
        while (choices.size < 4) {
          const offset = Math.floor(Math.random() * 9) - 4;
          if (offset !== 0) choices.add(ans + offset);
        }
        Array.from(choices).sort(() => Math.random() - 0.5).forEach(val => {
          const btn = document.createElement('button');
          btn.className = 'sprint-opt';
          btn.innerText = val;
          btn.onclick = () => answerSprint(String(val));
          optBox.appendChild(btn);
        });
      } else {
        const wordObj = STROOP_COLORS[Math.floor(Math.random() * STROOP_COLORS.length)];
        const inkObj = STROOP_COLORS[Math.floor(Math.random() * STROOP_COLORS.length)];
        qEl.innerText = wordObj.name;
        qEl.style.color = inkObj.hex;
        currentCorrectAns = inkObj.name;

        [...STROOP_COLORS].sort(() => Math.random() - 0.5).forEach(c => {
          const btn = document.createElement('button');
          btn.className = 'sprint-opt';
          btn.innerText = c.name;
          btn.onclick = () => answerSprint(c.name);
          optBox.appendChild(btn);
        });
      }
    }

    function answerSprint(val) {
      if (!sprintRunning) return;
      state.totalAttempts += 1;
      if (val === currentCorrectAns) {
        sprintScore++;
        state.totalCorrect += 1;
        beep('ok');
        buzz('light');
      } else {
        sprintScore = Math.max(0, sprintScore - 1);
        beep('err');
        buzz('error');
      }
      document.getElementById('sp-score').innerText = sprintScore;
      nextSprintPuzzle();
    }

    function endSprint() {
      clearInterval(sprintTimerId);
      sprintRunning = false;
      document.getElementById('sp-start-btn').disabled = false;
      document.getElementById('sp-start-btn').innerText = '🔄 Play Again (30s)';
      document.getElementById('sp-options').innerHTML = '';
      document.getElementById('sp-question').style.color = 'var(--accent)';
      document.getElementById('sp-question').innerText = `Score: ${sprintScore}`;

      if (sprintScore > 0) {
        const reward = Math.min(25, sprintScore * 2);
        state.gems += reward;
        state.sessions += 1;
        if (sprintScore > state.sprintBest) state.sprintBest = sprintScore;
        addHistory(`Sprint (${sprintMode})`, `${sprintScore} pts (+${reward} 💎)`);
        toast(`রাউন্ড শেষ! +${reward} 💎 অর্জিত`);
      }
      save();

      if (state.adConsent && !sprintAdUsed) {
        document.getElementById('sp-ad-btn').style.display = 'flex';
      }
    }

    function triggerAdForTime() {
      runRewardedAd(() => {
        sprintAdUsed = true;
        sprintRunning = true;
        sprintTime = 15;
        document.getElementById('sp-ad-btn').style.display = 'none';
        document.getElementById('sp-start-btn').disabled = true;
        document.getElementById('sp-timer').innerText = '15s';
        nextSprintPuzzle();

        clearInterval(sprintTimerId);
        sprintTimerId = setInterval(() => {
          sprintTime--;
          document.getElementById('sp-timer').innerText = `${sprintTime}s`;
          if (sprintTime <= 0) endSprint();
        }, 1000);
        toast('⏱ +15s Time Boost চালু হয়েছে!');
      });
    }

    // ================= PAGE 3: ANALYTICS & BADGES =================
    function addHistory(label, result) {
      state.history.unshift({ label, result, time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) });
      if (state.history.length > 6) state.history.pop();
    }

    function renderStats() {
      document.getElementById('st-sessions').innerText = state.sessions;
      const acc = state.totalAttempts > 0 ? Math.round((state.totalCorrect / state.totalAttempts) * 100) : 0;
      document.getElementById('st-accuracy').innerText = `${acc}%`;
      document.getElementById('st-gems').innerText = state.gems;

      const rank = state.sessions >= 20 ? 'Master Analyst' : state.sessions >= 6 ? 'Sharp Thinker' : 'Trainee';
      document.getElementById('rank-tag').innerText = rank;

      const badges = [
        { name: 'First Session', req: 'যেকোনো ১টি গেম সম্পন্ন করুন', ok: state.sessions >= 1 },
        { name: 'Memory Ace', req: 'Memory Level 5 অর্জন করুন', ok: state.memBest >= 5 },
        { name: 'Speed Demon', req: 'Sprint-এ ১২+ স্কোর করুন', ok: state.sprintBest >= 12 },
        { name: 'Precision Mind', req: '৮০%+ একুরেসি রাখুন (১০+ চেষ্টায়)', ok: state.totalAttempts >= 10 && acc >= 80 }
      ];

      document.getElementById('badges-box').innerHTML = badges.map(b => `
        <div class="list-row">
          <div><b>${b.name}</b><div class="desc" style="font-size:11px;">${b.req}</div></div>
          <span class="pill ${b.ok ? 'pill-ok' : 'pill-lock'}">${b.ok ? 'Unlocked' : 'Locked'}</span>
        </div>
      `).join('');

      const histEl = document.getElementById('history-box');
      if (state.history.length === 0) {
        histEl.innerHTML = '<div class="desc">এখনো কোনো সেশন রেকর্ড নেই।</div>';
      } else {
        histEl.innerHTML = state.history.map(h => `
          <div class="list-row">
            <span>${h.label} <small style="color:var(--muted);">(${h.time})</small></span>
            <b style="color:var(--accent);">${h.result}</b>
          </div>
        `).join('');
      }
    }

    // ================= PAGE 4: WORKSHOP & SETTINGS =================
    function buyShield() {
      if (state.gems < 40) return toast('৪০ 💎 প্রয়োজন');
      state.gems -= 40;
      state.shields += 1;
      save();
      buzz('success');
      toast('🛡 +1 Memory Shield কেনা হয়েছে!');
    }

    function handleTheme(key, hex, cost) {
      if (state.themes.includes(key)) {
        state.activeTheme = key;
        save();
        renderWorkshop();
        toast('থিম সক্রিয় করা হয়েছে!');
        return;
      }
      if (state.gems < cost) return toast(`${cost} 💎 প্রয়োজন`);
      state.gems -= cost;
      state.themes.push(key);
      state.activeTheme = key;
      save();
      renderWorkshop();
      buzz('success');
      toast('নতুন থিম আনলক হয়েছে!');
    }

    function renderWorkshop() {
      const mBtn = document.getElementById('btn-theme-mint');
      const vBtn = document.getElementById('btn-theme-violet');
      if (state.themes.includes('mint')) mBtn.innerText = state.activeTheme === 'mint' ? 'Active' : 'Apply';
      if (state.themes.includes('violet')) vBtn.innerText = state.activeTheme === 'violet' ? 'Active' : 'Apply';
    }

    function updatePreferences() {
      state.sound = document.getElementById('opt-sound').checked;
      state.haptic = document.getElementById('opt-haptic').checked;
      save();
    }

    function resetAll() {
      if (!confirm('সব ডেটা ও স্কোর রিসেট করতে চান?')) return;
      state = { ...DEFAULT_STATE, adConsent: state.adConsent };
      memLevel = 1; memLives = 2;
      save();
      renderStats();
      renderWorkshop();
      toast('রিসেট সম্পন্ন হয়েছে');
    }

    function refreshUI() {
      document.getElementById('gems-val').innerText = state.gems;
      document.getElementById('mem-best').innerText = state.memBest;
      document.getElementById('mem-shields').innerText = state.shields;
      document.getElementById('sp-best').innerText = state.sprintBest;
      document.getElementById('opt-sound').checked = state.sound;
      document.getElementById('opt-haptic').checked = state.haptic;
      document.getElementById('opt-ads').checked = Boolean(state.adConsent);

      const themeHex = { default: '#38bdf8', mint: '#10b981', violet: '#a855f7' }[state.activeTheme] || '#38bdf8';
      document.documentElement.style.setProperty('--accent', themeHex);
    }

    // Boot
    const user = tg?.initDataUnsafe?.user;
    if (user) {
      document.getElementById('tg-user-label').innerText = user.username ? `@${user.username}` : user.first_name;
    }
    refreshUI();
    checkConsent();
  </script>
</body>
</html>
